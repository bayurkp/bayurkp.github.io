                </div>
                <p class={`text-sm font-body leading-relaxed mt-3 ${descColor}`}>{p.description}</p>
              </div>
              <div class={`flex items-center gap-1.5 pt-3 mt-4 border-t ${dividerColor} font-mono text-xs ${footerTextColor}`}>
                {p.stack.map((tech, tIdx) => (
                  <>
                    <span class={`font-bold ${p.darkCard ? 'text-white' : 'text-black'}`}>{tech}</span>
                    {tIdx < p.stack.length - 1 && <span>•</span>}
