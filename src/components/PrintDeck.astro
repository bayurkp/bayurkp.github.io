          const isBottomRow = idx >= 3;
          const borderClasses = [
            !isRightCol ? 'border-r-2' : '',
            !isBottomRow ? 'border-b-2' : '',
            'border-black',
          ].filter(Boolean).join(' ');

          const bgClass = p.accentCard ? 'bg-accent' : p.darkCard ? 'bg-zinc-900' : 'bg-white';
          const titleColor = p.accentCard ? 'text-black' : p.darkCard ? 'text-white' : 'text-black';
          const descColor = p.accentCard ? 'text-black/85' : p.darkCard ? 'text-zinc-300' : 'text-zinc-700';
          const tagColor = p.accentCard ? 'text-black font-bold' : 'text-accent font-bold';
          const statBg = p.accentCard ? 'bg-black/15 text-black border border-black/30' : p.darkCard ? 'bg-white/15 text-white border border-white/30' : 'bg-zinc-100 text-black border border-black/20';
