---
const projects = [
  {
    title: 'Niagara POS',
    tagline: 'Offline-First Point of Sale',
    description:
      'Clean Architecture with bilateral SQLite-to-Supabase sync, FIFO transaction queues, and sub-20ms local write latency.',
    stack: ['Flutter', 'SQLite', 'Supabase'],
    stat: '<20ms Latency',
    darkCard: false,
    accentCard: false,
  },
  {
    title: 'Kaimify',
    tagline: 'Mindfulness & Habit App',
    description:
      'Harm-reduction platform with dual-currency transactional ledger, 2D room decorator, and AdMob server-side verification.',
    stack: ['NestJS', 'PostgreSQL', 'Drizzle ORM'],
    stat: 'Dual-Currency ACID',
    darkCard: true,
    accentCard: false,
  },
  {
    title: 'Kelompok Setia Hati',
    tagline: 'Multi-Region Community',
    description:
      '6-tier Spatie RBAC, automated serial PDF certificate generation, and regional donation ledger tracking.',
    stack: ['Next.js 15', 'Laravel 10', 'MySQL'],
    stat: '6-Tier RBAC',
    darkCard: false,
    accentCard: false,
  },
  {
    title: 'Memotions',
    tagline: 'AI Emotion Journal',
    description:
      'GCP Cloud Run backend with Pub/Sub ML inference pipelines. Ranked Top 50 out of 644 national teams.',
    stack: ['Express', 'GCP Run', 'Drizzle'],
    stat: 'Top 50 / 644 Teams',
    darkCard: false,
    accentCard: false,
  },
  {
    title: 'Moodyan',
    tagline: 'Web3 On-Chain Journal',
    description:
      'Decentralized wellness log on Internet Computer Protocol (ICP) with Motoko canisters, Internet Identity, and local LLM analysis.',
    stack: ['ICP', 'Motoko', 'React'],
    stat: '1st Place ICP Hub',
    darkCard: false,
    accentCard: true,
  },
  {
    title: 'TemanTaman',
    tagline: 'Agricultural Marketplace',
    description:
      'Real-time bidding and escrow settlement platform connecting ornamental plant growers directly to buyers.',
    stack: ['Laravel', 'MySQL', 'Tailwind'],
    stat: '3rd Place PNB #16',
    darkCard: false,
    accentCard: false,
  },
];

const experiences = [
  {
    period: 'Jul 2026 – Present',
    title: 'Software Engineer',
    company: 'Self-employed',
    description:
      'Engineered multi-region platforms (KSH) and academic systems (SIM-PKMTI) with Next.js 15, React 18, and Laravel 10.',
    stack: ['Next.js 15', 'Laravel 10', 'React 18'],
    darkCard: true,
  },
  {
    period: '2026 – Present',
    title: 'Fullstack Developer',
    company: 'Kaimify',
    description:
      'Building backend microservices in NestJS & PostgreSQL with dual-currency transactional ledgers.',
    stack: ['NestJS', 'PostgreSQL', 'Flutter'],
    darkCard: false,
  },
  {
    period: 'Jan 2026 – Jun 2026',
    title: 'Undergraduate Researcher',
    company: 'Udayana University',
    description:
      'Architected offline-first POS with Clean Architecture, SQLite sync, and sub-20ms write latency.',
    stack: ['Flutter', 'SQLite', 'Supabase'],
    darkCard: false,
  },
  {
    period: 'Mar 2025 – Jun 2025',
    title: 'Frontend Developer Intern',
    company: 'Timedoor Indonesia',
    description:
      'Developed Vue.js web interfaces, integrated REST APIs, and resolved 100+ UI & logic issues.',
    stack: ['Vue.js', 'REST API', 'Git'],
    darkCard: false,
  },
  {
    period: 'Aug 2024 – Present',
    title: 'Programming Teacher',
    company: 'Timedoor Academy',
    description:
      'Delivering bilingual instruction in Python, Machine Learning, AI algorithms, and Vue.js fundamentals.',
    stack: ['Python', 'Teaching', 'Vue.js'],
    darkCard: false,
  },
  {
    period: 'Feb 2024 – Jul 2024',
    title: 'Cloud Computing Cohort',
    company: 'Bangkit Academy',
    description:
      'Built Google Cloud infrastructure. Led team of 7 to Top 50 Capstone ranking out of 644 national teams.',
    stack: ['GCP', 'Docker', 'Express'],
    darkCard: false,
  },
  {
    period: 'Sep 2023 – Jun 2024',
    title: 'Teaching Assistant',
    company: 'Udayana University',
    description:
      'Instructed C/C++ Algorithms & Programming and Database Concepts (MySQL, ERD, PDM).',
    stack: ['C/C++', 'Algorithms', 'MySQL'],
    darkCard: false,
  },
  {
    period: 'Jan 2024 – Dec 2024',
    title: 'Vice Chairman',
    company: 'Technology Artisan',
    description:
      'Coordinated technical programs across 6 engineering divisions in student developer community.',
    stack: ['Leadership', 'Teamwork'],
    darkCard: false,
  },
];
---

<div id="print-deck" class="print-deck-root">
  <!-- SLIDE 1: OVERVIEW -->
  <div class="print-slide">
    <div
      class="w-full h-full bg-white border-3 border-black flex flex-col justify-between overflow-hidden shadow-none"
    >
      <div class="flex-1 grid grid-cols-12 min-h-0 divide-x-2 divide-black">
        <!-- Photo Card (Cols 1-3) -->
        <div class="col-span-3 relative overflow-hidden bg-zinc-900 flex flex-col">
          <img
            src="/images/bay-1.jpeg"
            alt="Bayu Pratama"
            class="absolute inset-0 w-full h-full object-cover object-[42%_center] grayscale contrast-125 opacity-70"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent">
          </div>
          <div class="relative flex flex-col justify-end h-full p-6 gap-1 z-10">
            <p class="font-mono text-xs text-accent font-bold uppercase tracking-widest">
              01 • Profile
            </p>
            <h1 class="text-2xl font-heading font-black text-white leading-tight">
              Bayu Rizky<br />Kurnia Pratama
            </h1>
            <p class="text-sm font-mono text-zinc-200 mt-1 font-semibold">Software Engineer</p>
            <p class="text-xs font-mono text-accent font-bold">
              Fullstack • Backend • AI Integration
            </p>
          </div>
        </div>

        <!-- Right 9 Columns (3x2 Grid) -->
        <div class="col-span-9 grid grid-cols-3 grid-rows-2 divide-y-2 divide-black">
          <!-- B: Big Stat -->
          <div class="bg-accent p-6 flex flex-col justify-between border-r-2 border-black">
            <div class="flex items-start justify-between">
              <span class="font-mono text-xs font-bold text-black uppercase tracking-widest"
                >Projects Shipped</span
              >
              <svg
                class="w-6 h-6 text-black/50"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path
                  d="M2 12l10 5 10-5"></path></svg
              >
            </div>
            <div>
              <div class="text-6xl font-heading font-black text-black leading-none">10+</div>
              <p class="text-xs font-mono font-bold text-black/80 mt-2">
                Production & research systems
              </p>
            </div>
          </div>

          <!-- C: Work Text -->
          <div class="bg-white p-6 flex flex-col justify-between border-r-2 border-black">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest"
                  >02 • Work</span
                >
                <svg
                  class="w-4 h-4 text-accent"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg
                >
              </div>
              <h2 class="text-xl font-heading font-black text-black">Featured Projects</h2>
              <p class="text-xs font-body text-zinc-700 mt-2 leading-relaxed">
                Offline-first POS, dual-currency wellness app, decentralized Web3 journal, and
                enterprise community platforms.
              </p>
            </div>
            <div class="text-xs font-mono text-zinc-500 font-bold mt-3">
              Niagara POS • Kaimify • Moodyan • KSH
            </div>
          </div>

          <!-- D: Wins -->
          <div class="bg-zinc-900 p-6 flex flex-col justify-between border-black text-white">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest"
                >05 • Wins</span
              >
              <svg
                class="w-6 h-6 text-zinc-500"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path
                  d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path
                  d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path
                  d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path
                  d="M18 2H6v7a6 6 0 0 0 12 0V2z"></path></svg
              >
            </div>
            <div>
              <div class="text-5xl font-heading font-black text-white leading-none">1st Place</div>
              <p class="text-xs font-mono text-accent mt-2 font-bold">ICP Indonesia Hackathon</p>
              <p class="text-xs font-mono text-zinc-400 mt-0.5">+ BAZNAS National Scholar</p>
            </div>
          </div>

          <!-- E: About / Bio -->
          <div class="bg-white p-6 flex flex-col justify-between border-r-2 border-black">
            <div>
              <p class="text-sm font-body text-zinc-800 leading-relaxed">
                I design and build backend services — APIs, data sync engines, transactional
                ledgers, and LLM integrations. Focused on systems that work reliably offline and at
                scale.
              </p>
            </div>
            <div
              class="pt-3 border-t border-black/10 flex items-center justify-between text-xs font-mono"
            >
              <span class="text-zinc-500 font-semibold">Current Role</span>
              <span class="font-bold text-black">Fullstack Dev @ Kaimify</span>
            </div>
          </div>

          <!-- F: Tech Grid -->
          <div class="bg-white p-6 flex flex-col justify-between border-r-2 border-black">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest"
                >03 • Stack</span
              >
              <svg
                class="w-4 h-4 text-accent"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg
              >
            </div>
            <div class="grid grid-cols-2 gap-1.5 font-mono text-xs font-bold flex-1">
              {
                [
                  'NestJS',
                  'Node.js',
                  'Laravel',
                  'Go',
                  'Flutter',
                  'PostgreSQL',
                  'SQLite',
                  'Docker',
                ].map((t) => (
                  <div class="px-2 py-1.5 bg-zinc-100 border border-black/20 text-black font-bold truncate flex items-center justify-center">
                    {t}
                  </div>
                ))
              }
            </div>
          </div>

          <!-- G: Experience -->
          <div class="bg-white p-6 flex flex-col justify-between border-black">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest"
                >04 • Career</span
              >
              <svg
                class="w-4 h-4 text-accent"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg
              >
            </div>
            <div class="space-y-2 flex-1">
              {
                [
                  { role: 'Kaimify', label: 'Fullstack Dev', year: '2026', active: true },
                  { role: 'Timedoor', label: 'Programming Teacher', year: '2024', active: false },
                  {
                    role: 'Bangkit',
                    label: 'Cloud Computing — Top 10%',
                    year: '2024',
                    active: false,
                  },
                ].map((e) => (
                  <div
                    class={`flex items-center justify-between px-3 py-2 border font-mono text-xs ${e.active ? 'bg-accent text-black border-black font-bold' : 'bg-zinc-100 border-black/20 text-black'}`}
                  >
                    <span class="font-bold truncate">{e.role}</span>
                    <span
                      class={`text-[11px] ${e.active ? 'text-black font-bold' : 'text-zinc-600'}`}
                    >
                      {e.year}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <footer
        class="border-t-2 border-black bg-zinc-50 px-5 py-2 flex items-center justify-between text-xs font-mono shrink-0"
      >
        <div class="flex items-center gap-2">
          <span class="font-bold text-black">Bayu Pratama</span>
          <span class="opacity-40">•</span>
          <span class="text-zinc-600 font-semibold">Software Engineer</span>
        </div>
        <span class="font-bold px-2 py-0.5 bg-black text-white">1 / 6</span>
      </footer>
    </div>
  </div>

  <!-- SLIDE 2: PROJECTS -->
  <div class="print-slide">
    <div
      class="w-full h-full bg-white border-3 border-black flex flex-col justify-between overflow-hidden shadow-none"
    >
      <div
        class="h-16 flex items-center justify-between border-b-2 border-black bg-zinc-50 px-6 shrink-0"
      >
        <div>
          <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider"
            >02 • Selected Work</span
          >
          <h2 class="text-2xl font-heading font-black text-black leading-tight">
            Featured Projects
          </h2>
        </div>
        <span class="text-xs font-mono text-zinc-600 font-semibold"
          >6 Production & Research Systems</span
        >
      </div>

      <div class="grid grid-cols-3 flex-1 min-h-0">
        {
          projects.map((p, idx) => {
            const isRightCol = (idx + 1) % 3 === 0;
            const isBottomRow = idx >= 3;
            const borderClasses = [
              !isRightCol ? 'border-r-2' : '',
              !isBottomRow ? 'border-b-2' : '',
              'border-black',
            ]
              .filter(Boolean)
              .join(' ');

            const bgClass = p.accentCard ? 'bg-accent' : p.darkCard ? 'bg-zinc-900' : 'bg-white';
            const titleColor = p.accentCard
              ? 'text-black'
              : p.darkCard
                ? 'text-white'
                : 'text-black';
            const descColor = p.accentCard
              ? 'text-black/85'
              : p.darkCard
                ? 'text-zinc-300'
                : 'text-zinc-700';
            const tagColor = p.accentCard ? 'text-black font-bold' : 'text-accent font-bold';
            const statBg = p.accentCard
              ? 'bg-black/15 text-black border border-black/30'
              : p.darkCard
                ? 'bg-white/15 text-white border border-white/30'
                : 'bg-zinc-100 text-black border border-black/20';
            const dividerColor = p.darkCard
              ? 'border-white/20'
              : p.accentCard
                ? 'border-black/25'
                : 'border-black/15';
            const footerTextColor = p.darkCard
              ? 'text-zinc-300'
              : p.accentCard
                ? 'text-black/75'
                : 'text-zinc-600';

            return (
              <div class={`${bgClass} ${borderClasses} p-6 flex flex-col justify-between`}>
                <div>
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <div>
                      <h3 class={`font-heading font-bold text-xl leading-tight ${titleColor}`}>
                        {p.title}
                      </h3>
                      <p class={`text-xs font-mono ${tagColor} mt-0.5`}>{p.tagline}</p>
                    </div>
                    <span
                      class={`px-2 py-0.5 font-mono font-bold text-[11px] whitespace-nowrap ${statBg}`}
                    >
                      {p.stat}
                    </span>
                  </div>
                  <p class={`text-sm font-body leading-relaxed mt-3 ${descColor}`}>
                    {p.description}
                  </p>
                </div>
                <div
                  class={`flex items-center gap-1.5 pt-3 mt-4 border-t ${dividerColor} font-mono text-xs ${footerTextColor}`}
                >
                  {p.stack.map((tech, tIdx) => (
                    <>
                      <span class={`font-bold ${p.darkCard ? 'text-white' : 'text-black'}`}>
                        {tech}
                      </span>
                      {tIdx < p.stack.length - 1 && <span>•</span>}
                    </>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>

      <footer
        class="border-t-2 border-black bg-zinc-50 px-5 py-2 flex items-center justify-between text-xs font-mono shrink-0"
      >
        <div class="flex items-center gap-2">
          <span class="font-bold text-black">Bayu Pratama</span>
          <span class="opacity-40">•</span>
          <span class="text-zinc-600 font-semibold">Software Engineer</span>
        </div>
        <span class="font-bold px-2 py-0.5 bg-black text-white">2 / 6</span>
      </footer>
    </div>
  </div>

  <!-- SLIDE 3: STACK -->
  <div class="print-slide">
    <div
      class="w-full h-full bg-white border-3 border-black flex flex-col justify-between overflow-hidden shadow-none"
    >
      <div
        class="h-16 flex items-center justify-between border-b-2 border-black bg-zinc-50 px-6 shrink-0"
      >
        <div>
          <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider"
            >03 • Core Tools</span
          >
          <h2 class="text-2xl font-heading font-black text-black leading-tight">Technical Stack</h2>
        </div>
        <div class="text-xs font-mono text-zinc-600 font-semibold">Backend-First Development</div>
      </div>

      <div class="grid grid-cols-2 flex-1 min-h-0 divide-x-2 divide-black">
        <div class="flex flex-col divide-y-2 divide-black">
          <div class="flex-1 bg-white p-7 flex flex-col justify-between">
            <div>
              <h3 class="font-heading font-bold text-2xl text-black mb-2">Backend Development</h3>
              <p class="text-sm font-body text-zinc-700 leading-relaxed mb-4">
                Building scalable REST APIs, background job workers, and business logic using
                Node.js, Go, and PHP.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 font-mono text-xs font-bold">
              {
                ['NestJS', 'Node.js', 'Laravel', 'Go', 'TypeScript', 'Python'].map((t) => (
                  <span class="px-3 py-1 bg-zinc-100 border border-black/20 text-black font-bold">
                    {t}
                  </span>
                ))
              }
            </div>
          </div>
          <div class="flex-1 bg-white p-7 flex flex-col justify-between">
            <div>
              <h3 class="font-heading font-bold text-2xl text-black mb-2">Databases & DevOps</h3>
              <p class="text-sm font-body text-zinc-700 leading-relaxed mb-4">
                Relational schemas with Drizzle ORM, offline SQLite caching, Docker containers, and
                Google Cloud Run.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 font-mono text-xs font-bold">
              {
                ['PostgreSQL', 'SQLite', 'Supabase', 'Drizzle ORM', 'Docker', 'Google Cloud'].map(
                  (t) => (
                    <span class="px-3 py-1 bg-zinc-100 border border-black/20 text-black font-bold">
                      {t}
                    </span>
                  )
                )
              }
            </div>
          </div>
        </div>

        <div class="flex flex-col divide-y-2 divide-black">
          <div class="flex-1 bg-white p-7 flex flex-col justify-between">
            <div>
              <h3 class="font-heading font-bold text-2xl text-black mb-2">Frontend & Mobile</h3>
              <p class="text-sm font-body text-zinc-700 leading-relaxed mb-4">
                Cross-platform mobile applications in Flutter, and modern responsive web interfaces
                in React and Next.js.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 font-mono text-xs font-bold">
              {
                ['Flutter', 'Dart', 'React', 'Next.js 15', 'Vue.js', 'Tailwind CSS'].map((t) => (
                  <span class="px-3 py-1 bg-zinc-100 border border-black/20 text-black font-bold">
                    {t}
                  </span>
                ))
              }
            </div>
          </div>
          <div class="flex-1 bg-white p-7 flex flex-col justify-between">
            <div>
              <h3 class="font-heading font-bold text-2xl text-black mb-2">Architectural Focus</h3>
              <p class="text-sm font-body text-zinc-700 leading-relaxed mb-4">
                Core architectural patterns implemented and battle-tested across production
                applications.
              </p>
            </div>
            <div class="flex flex-wrap gap-2 font-mono text-xs font-bold">
              {
                [
                  'Offline-First Data Sync',
                  'Dual-Currency Ledgers',
                  'Model Context Protocol (MCP)',
                  'Clean Architecture',
                ].map((t) => (
                  <span class="px-3 py-1 bg-zinc-100 border border-black/20 text-black font-bold">
                    {t}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <footer
        class="border-t-2 border-black bg-zinc-50 px-5 py-2 flex items-center justify-between text-xs font-mono shrink-0"
      >
        <div class="flex items-center gap-2">
          <span class="font-bold text-black">Bayu Pratama</span>
          <span class="opacity-40">•</span>
          <span class="text-zinc-600 font-semibold">Software Engineer</span>
        </div>
        <span class="font-bold px-2 py-0.5 bg-black text-white">3 / 6</span>
      </footer>
    </div>
  </div>

  <!-- SLIDE 4: EXPERIENCE -->
  <div class="print-slide">
    <div
      class="w-full h-full bg-white border-3 border-black flex flex-col justify-between overflow-hidden shadow-none"
    >
      <div
        class="h-16 flex items-center justify-between border-b-2 border-black bg-zinc-50 px-6 shrink-0"
      >
        <div>
          <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider"
            >04 • Career</span
          >
          <h2 class="text-2xl font-heading font-black text-black leading-tight">
            Where I've Worked
          </h2>
        </div>
        <div class="text-xs font-mono text-zinc-600 font-semibold">
          Industry • Research • Education • Leadership
        </div>
      </div>

      <!-- 8-Card Grid (4 Columns x 2 Rows) -->
      <div class="grid grid-cols-4 flex-1 min-h-0">
        {
          experiences.map((exp, idx) => {
            const isRightCol = (idx + 1) % 4 === 0;
            const isBottomRow = idx >= 4;
            const borderClasses = [
              !isRightCol ? 'border-r-2' : '',
              !isBottomRow ? 'border-b-2' : '',
              'border-black',
            ]
              .filter(Boolean)
              .join(' ');

            const bgClass = exp.darkCard ? 'bg-zinc-900 text-white' : 'bg-white text-black';
            const titleColor = exp.darkCard ? 'text-white' : 'text-black';
            const descColor = exp.darkCard ? 'text-zinc-300' : 'text-zinc-700';
            const periodColor = exp.darkCard ? 'text-zinc-400' : 'text-zinc-500';
            const borderDivider = exp.darkCard ? 'border-white/15' : 'border-black/10';
            const stackColor = exp.darkCard ? 'text-zinc-400' : 'text-zinc-600';

            return (
              <div class={`${bgClass} ${borderClasses} p-5 flex flex-col justify-between`}>
                <div>
                  <span class={`text-[11px] font-mono font-semibold ${periodColor}`}>
                    {exp.period}
