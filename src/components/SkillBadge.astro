---
interface Props {
  name: string;
  category?: string;
}

const { name, category } = Astro.props;
---

<span
  class={`inline-flex items-center px-3 py-1 font-mono text-sm border-2 ${
    category === 'Frontend'
      ? 'border-blue-500 bg-blue-50 dark:bg-blue-950'
      : category === 'Backend'
        ? 'border-green-500 bg-green-50 dark:bg-green-950'
        : category === 'Tools'
          ? 'border-purple-500 bg-purple-50 dark:bg-purple-950'
          : 'border-black dark:border-white bg-white dark:bg-neutral-800'
  }`}
>
  {name}
</span>
