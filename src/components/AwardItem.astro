---
interface Props {
  title: string;
  organization: string;
  date: string;
  description?: string;
}

const { title, organization, date, description } = Astro.props;
---

<div class="relative pl-8 pb-8 border-l-2 border-dashed border-black dark:border-white last:pb-0">
  <div class="absolute left-[-12px] top-0 w-6 h-6 bg-white dark:bg-neutral-900 border-2 border-black dark:border-white rounded-full flex items-center justify-center">
    <span class="text-xs">🏆</span>
  </div>
  <div class="border-2 border-black dark:border-white bg-white dark:bg-neutral-900 p-5 ml-2 transform hover:rotate-1 transition-transform duration-150">
    <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
      <div>
        <h3 class="font-heading font-bold text-lg leading-tight">{title}</h3>
        <p class="font-body text-accent font-medium">{organization}</p>
      </div>
      <span class="px-3 py-1 text-xs font-mono border border-black dark:border-white bg-accent text-black">
        {date}
      </span>
    </div>
    {description && (
      <p class="font-body text-sm opacity-80 leading-relaxed">{description}</p>
    )}
  </div>
</div>
