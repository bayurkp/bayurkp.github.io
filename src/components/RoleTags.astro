---
const roles = [
  'Backend Engineer',
  'Systems Architect',
  'AI Integration',
  'Cloud Engineer',
  'GCP Certified',
  'Fullstack Developer',
  'Programming Teacher',
  'Problem Solver'
];
---

<div class="overflow-hidden border-b-2 border-black dark:border-white bg-accent py-4">
  <div class="animate-scroll flex whitespace-nowrap">
    {[...roles, ...roles].map((role, i) => (
      <span class="mx-8 text-xl md:text-2xl font-heading font-bold text-black">
        {role}
        <span class="mx-8 text-black/30">/</span>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .animate-scroll {
    animation: scroll 20s linear infinite;
  }
</style>
