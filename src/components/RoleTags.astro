---
const works = [
  'Backend Engineering',
  'System Architecture',
  'AI & LLM Integration',
  'Cloud Infrastructure',
  'Web Development',
  'API Design',
  'Database Management',
  'DevOps & CI/CD',
  'Technical Mentoring',
  'Competitive Programming'
];
---

<div class="overflow-hidden border-b-2 border-black dark:border-white bg-accent py-4">
  <div class="animate-scroll flex whitespace-nowrap">
    {[...works, ...works].map((work) => (
      <span class="mx-8 text-xl md:text-2xl font-heading font-bold text-black">
        {work}
        <span class="mx-8 text-black/30">/</span>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .animate-scroll {
    animation: scroll 25s linear infinite;
  }
</style>
