---
interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  tags?: string[];
}

const { title, description, date, slug, tags } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="card-neo p-6 group">
  <div class="flex items-start justify-between gap-4 mb-3">
    <span class="text-xs font-mono opacity-60">{formattedDate}</span>
    <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
  <a href={`/blog/${slug}`} class="block">
    <h3 class="font-heading font-bold text-xl mb-2 group-hover:text-accent transition-colors">{title}</h3>
    <p class="font-body text-sm opacity-80 mb-4">{description}</p>
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="px-2 py-1 text-xs font-mono border border-black dark:border-white bg-accent/10">
            {tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>
