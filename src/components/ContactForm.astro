---

<section id="contact" class="py-16 border-b-2 border-black dark:border-white">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8">Get in Touch</h2>
    <div class="max-w-xl mx-auto">
      <form action="https://formsubmit.co/bayurkp194@gmail.com" method="POST" class="space-y-6">
        <input type="hidden" name="_subject" value="New Contact Message from bayurkp.github.io" />
        <input type="hidden" name="_captcha" value="false" />
        <div>
          <label for="name" class="block font-heading font-bold mb-2">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="input-neo"
            placeholder="Your name"
          />
        </div>
        <div>
          <label for="email" class="block font-heading font-bold mb-2">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="input-neo"
            placeholder="your@email.com"
          />
        </div>
        <div>
          <label for="message" class="block font-heading font-bold mb-2">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows={5}
            class="input-neo resize-none"
            placeholder="Your message..."></textarea>
        </div>
        <button type="submit" class="btn-neo w-full bg-accent text-black">Send Message</button>
      </form>
    </div>
  </div>
</section>
