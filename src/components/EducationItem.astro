---
interface Props {
  degree: string;
  institution: string;
  location?: string;
  startDate: string;
  endDate?: string;
  current?: boolean;
  description?: string;
}

const {
  degree,
  institution,
  location,
  startDate,
  endDate,
  current = false,
  description,
} = Astro.props;
---

<div
  class="group relative border-2 border-black dark:border-white bg-white dark:bg-neutral-900 p-6 shadow-neo dark:shadow-neo-dark hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-200 mb-6 last:mb-0"
>
  <!-- Decorative top-right tab -->
  <div
    class="absolute -top-4 right-2 w-12 h-12 bg-accent border-2 border-black dark:border-white rounded-full flex items-center justify-center z-10 shadow-neo-sm"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-black"
      ><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg
    >
  </div>

  <div class="flex flex-col md:flex-row gap-6">
    <div class="flex-1">
      <div
        class="inline-block px-3 py-1 mb-3 text-xs font-mono font-bold border-2 border-black dark:border-white bg-accent/20 dark:bg-accent/10"
      >
        {current ? `${startDate} - Present` : `${startDate} - ${endDate}`}
      </div>
      <h3 class="font-heading font-black text-2xl tracking-tight mb-1">{degree}</h3>
      <p class="font-heading text-lg font-bold opacity-80">{institution}</p>

      {
        location && (
          <p class="font-body text-sm font-semibold opacity-60 mt-1 flex items-center gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </>
            </svg>
            {location}
          </p>
        )
      }

      {
        description && (
          <p class="font-body text-base opacity-90 leading-relaxed mt-4 pt-4 border-t-2 border-dashed border-black/20 dark:border-white/20">
            {description}
          </p>
        )
      }
    </div>
  </div>
</div>
