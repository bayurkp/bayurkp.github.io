---
interface Props {
  title: string;
  subtitle: string;
  date: string;
  description?: string;
  current?: boolean;
}

const { title, subtitle, date, description, current = false } = Astro.props;
---

<div class="relative pl-8 pb-8 border-l-2 border-black dark:border-white last:pb-0">
  <div
    class={`absolute left-[-9px] top-0 w-4 h-4 border-2 border-black dark:border-white ${current ? 'bg-accent' : 'bg-white dark:bg-neutral-900'}`}
  >
  </div>
  <div
    class="border-2 border-black dark:border-white bg-white dark:bg-neutral-900 p-4 ml-4 shadow-neo dark:shadow-neo-dark transition-all duration-150 hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
  >
    <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
      <div>
        <h3 class="font-heading font-bold text-lg">{title}</h3>
        <p class="font-body text-accent">{subtitle}</p>
      </div>
      <span
        class={`px-3 py-1 text-xs font-mono border-2 border-black dark:border-white ${current ? 'bg-accent text-black' : 'bg-white dark:bg-neutral-800'}`}
      >
        {date}
      </span>
    </div>
    {description && <p class="font-body text-sm opacity-80">{description}</p>}
  </div>
</div>
