---
import Button from './Button.astro';
---

<section class="min-h-[90vh] flex items-center border-b-2 border-black dark:border-white">
  <div class="container mx-auto px-4 py-16">
    <div class="max-w-4xl">
      <h1 class="text-5xl md:text-7xl font-heading font-bold mb-6 leading-tight">
        Hi, I'm <span class="text-accent">Your Name</span>
      </h1>
      <p class="text-xl md:text-2xl font-body mb-8 max-w-2xl">
        Full-stack developer passionate about building beautiful, performant web applications. I turn complex problems into elegant solutions.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/#projects" variant="primary">View Projects</Button>
        <Button href="/contact" variant="secondary">Get in Touch</Button>
      </div>
    </div>
  </div>
</section>

<section class="py-16 border-b-2 border-black dark:border-white">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8">About Me</h2>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <p class="font-body text-lg">
          I'm a software developer with experience building web applications using modern technologies. I enjoy working on both frontend and backend, always striving for clean, maintainable code.
        </p>
        <p class="font-body text-lg">
          When I'm not coding, you'll find me exploring new technologies, contributing to open source, or sharing knowledge through blog posts.
        </p>
      </div>
      <div class="border-2 border-black dark:border-white p-6 bg-white dark:bg-neutral-900">
        <h3 class="font-heading font-bold text-xl mb-4">Quick Facts</h3>
        <ul class="space-y-2 font-body">
          <li class="flex items-center gap-2">
            <span class="text-accent font-bold">→</span>
            <span>Based in Your Location</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-accent font-bold">→</span>
            <span>Open to opportunities</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-accent font-bold">→</span>
            <span>5+ years experience</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
