---
import Button from './ui/Button.astro';
import RoleTags from './RoleTags.astro';
---

<section class="min-h-[90vh] flex items-center border-b-2 border-black dark:border-white">
  <div class="container mx-auto px-4 py-16">
    <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
      <div class="flex-1">
        <h1 class="text-5xl md:text-7xl font-heading font-bold mb-6 leading-tight">
          Hi, I'm <span class="text-accent">Bayu Pratama</span>
        </h1>
        <p class="text-xl md:text-2xl font-body mb-8 max-w-2xl">
          Backend Engineer and System Design Enthusiast with practical experience in building
          scalable applications, virtual economies, and AI/LLM-integrated architectures.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/#projects" variant="primary">View Projects</Button>
          <Button href="/contact" variant="secondary">Get in Touch</Button>
        </div>
      </div>

      <div class="flex-1 w-full max-w-md md:max-w-none">
        <div
          class="aspect-square border-4 border-black dark:border-white bg-accent shadow-neo dark:shadow-neo-dark rotate-2 hover:rotate-0 transition-transform duration-300 relative group overflow-hidden"
        >
          <!-- Profile Image with Duotone Effect -->
          <img
            src="images/bay-1.jpeg"
            alt="Bayu Pratama"
            class="w-full h-full object-cover grayscale mix-blend-multiply group-hover:mix-blend-normal group-hover:grayscale-0 transition-all duration-500"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<RoleTags />

<section id="about" class="py-16 border-b-2 border-black dark:border-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
      <div class="flex-1 w-full max-w-md md:max-w-none order-2 md:order-1">
        <div
          class="aspect-square border-4 border-black dark:border-white bg-neutral-200 dark:bg-neutral-800 shadow-neo dark:shadow-neo-dark -rotate-2 hover:rotate-0 transition-transform duration-300 relative"
        >
          <!-- About Profile Image -->
          <img
            src="images/bay-2.jpeg"
            alt="About Bayu Pratama"
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-300"
          />
        </div>
      </div>

      <div class="flex-1 order-1 md:order-2">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8">About Me</h2>
        <div class="space-y-4">
          <p class="font-body text-lg">
            I am a Backend Engineer and System Design Enthusiast with practical experience in building
            scalable, resilient applications. I develop robust backend architectures, including virtual
            economies, event-driven pipelines, and gamification engines, utilizing Node.js, NestJS,
            Go, and PHP.
          </p>
          <p class="font-body text-lg">
            Demonstrating strong collaborative skills, I coordinate cross-functional teams to deliver
            end-to-end solutions across web and mobile platforms. I am passionate about system
            infrastructure, distributed data layers, and integrating advanced technologies like LLMs to
            build impactful, forward-thinking products.
          </p>
          <p class="font-body text-lg">
            Currently pursuing my Bachelor of Computer Science at Udayana University (GPA 3.93/4.0)
            while serving as a Fullstack Developer at Kaimify, teaching programming, and authoring
            research in offline-first systems.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
