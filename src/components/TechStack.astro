---
const techStack = [
  {
    category: 'Frontend',
    icon: '🎨',
    items: ['React', 'Next.js', 'Vue', 'Nuxt', 'Tailwind CSS', 'TypeScript']
  },
  {
    category: 'Backend',
    icon: '⚙️',
    items: ['Node.js', 'Go', 'PHP', 'Laravel', 'Express', 'PostgreSQL']
  },
  {
    category: 'Cloud & DevOps',
    icon: '☁️',
    items: ['GCP', 'Docker', 'Git', 'Firebase', 'Cloud Run']
  },
  {
    category: 'AI & Tools',
    icon: '🤖',
    items: ['LLM Integration', 'MCP', 'Drizzle ORM', 'REST API']
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
  {techStack.map((stack, index) => (
    <div class={`border-2 border-black dark:border-white p-6 bg-white dark:bg-neutral-900 shadow-neo dark:shadow-neo-dark hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150 ${
      index === 0 ? 'lg:col-span-2' : ''
    }`}>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-3xl">{stack.icon}</span>
        <h3 class="font-heading font-bold text-lg">{stack.category}</h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {stack.items.map((tech) => (
          <span class="px-3 py-1.5 text-sm font-mono border border-black dark:border-white bg-neutral-light dark:bg-neutral-800 hover:bg-accent hover:text-black hover:border-accent transition-colors cursor-default">
            {tech}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
