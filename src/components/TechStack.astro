---
const techStack = [
  {
    category: 'Backend & Frameworks',
    items: [
      { name: 'NestJS', logo: 'https://cdn.simpleicons.org/nestjs/E0234E' },
      { name: 'Node.js', logo: 'https://cdn.simpleicons.org/nodedotjs/339933' },
      { name: 'Express', logo: 'https://cdn.simpleicons.org/express/000000' },
      { name: 'Laravel', logo: 'https://cdn.simpleicons.org/laravel/FF2D20' },
      { name: 'Go', logo: 'https://cdn.simpleicons.org/go/00ADD8' },
      { name: 'PHP', logo: 'https://cdn.simpleicons.org/php/777BB4' },
      { name: 'Python', logo: 'https://cdn.simpleicons.org/python/3776AB' },
      { name: 'C/C++', logo: 'https://cdn.simpleicons.org/cplusplus/00599C' },
    ],
  },
  {
    category: 'Frontend & Mobile',
    items: [
      { name: 'Flutter', logo: 'https://cdn.simpleicons.org/flutter/02569B' },
      { name: 'Dart', logo: 'https://cdn.simpleicons.org/dart/0175C2' },
      { name: 'TypeScript', logo: 'https://cdn.simpleicons.org/typescript/3178C6' },
      { name: 'JavaScript', logo: 'https://cdn.simpleicons.org/javascript/F7DF1E' },
      { name: 'React', logo: 'https://cdn.simpleicons.org/react/61DAFB' },
      { name: 'Next.js', logo: 'https://cdn.simpleicons.org/nextdotjs/000000' },
      { name: 'Vue', logo: 'https://cdn.simpleicons.org/vuedotjs/4FC08D' },
      { name: 'Nuxt', logo: 'https://cdn.simpleicons.org/nuxtdotjs/00DC82' },
      { name: 'Tailwind CSS', logo: 'https://cdn.simpleicons.org/tailwindcss/06B6D4' },
    ],
  },
  {
    category: 'Databases & Cloud',
    items: [
      { name: 'PostgreSQL', logo: 'https://cdn.simpleicons.org/postgresql/41678D' },
      { name: 'SQLite', logo: 'https://cdn.simpleicons.org/sqlite/003B57' },
      { name: 'Supabase', logo: 'https://cdn.simpleicons.org/supabase/3ECF8E' },
      { name: 'Drizzle ORM', logo: 'https://cdn.simpleicons.org/drizzle/C5F74F' },
      { name: 'GCP', logo: 'https://cdn.simpleicons.org/googlecloud/4285F4' },
      { name: 'Firebase', logo: 'https://cdn.simpleicons.org/firebase/FFCA28' },
      { name: 'Docker', logo: 'https://cdn.simpleicons.org/docker/2496ED' },
      { name: 'Git', logo: 'https://cdn.simpleicons.org/git/F05032' },
    ],
  },
  {
    category: 'AI & Web3',
    items: [
      { name: 'LLM & AI', logo: 'https://cdn.simpleicons.org/openai/412991' },
      { name: 'Web3 / ICP', logo: 'https://cdn.simpleicons.org/dfinity/29ABE2' },
    ],
  },
];

const allSkills = techStack.flatMap((stack) => stack.items);
---

<div class="flex flex-wrap gap-4 pt-4 justify-center">
  {
    allSkills.map((tech) => (
      <div class="flex items-center gap-3 px-4 py-3 border-2 border-black dark:border-white bg-white dark:bg-neutral-900 shadow-neo-sm dark:shadow-neo-dark-sm hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] hover:bg-accent dark:hover:bg-accent hover:text-black hover:border-black dark:hover:border-black transition-all duration-150 group">
        <img src={tech.logo} alt={tech.name} class="w-6 h-6 grayscale group-hover:grayscale-0 transition-all duration-300" loading="lazy" />
        <span class="text-base font-heading font-bold">{tech.name}</span>
      </div>
    ))
  }
</div>
