---
const techStack = {
  'Frontend': ['React', 'Next.js', 'Vue', 'Nuxt', 'Tailwind CSS', 'TypeScript'],
  'Backend': ['Node.js', 'Go', 'PHP', 'Laravel', 'Express', 'PostgreSQL'],
  'Cloud & DevOps': ['GCP', 'Docker', 'Git', 'Firebase', 'Cloud Run'],
  'AI & Tools': ['LLM Integration', 'MCP', 'Drizzle ORM', 'REST API']
};
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {Object.entries(techStack).map(([category, items], index) => (
    <div class={`border-2 border-black dark:border-white p-4 ${
      index === 0 ? 'md:col-span-2 md:row-span-2' : ''
    } bg-white dark:bg-neutral-900 shadow-neo dark:shadow-neo-dark hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150`}>
      <h3 class="font-heading font-bold text-lg mb-3 text-accent">{category}</h3>
      <div class="flex flex-wrap gap-2">
        {items.map((tech) => (
          <span class="px-3 py-1 text-sm font-mono border border-black dark:border-white bg-neutral-light dark:bg-neutral-800">
            {tech}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
