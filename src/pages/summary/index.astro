---
import SummaryLayout from '../../layouts/SummaryLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const experiences = await getCollection('experience');
const awards = await getCollection('awards');
---

<SummaryLayout
  title="Executive Summary & Architecture Portfolio"
  slideNumber={1}
  totalSlides={6}
  currentSlug="/summary"
  nextSlug="/summary/projects"
>
  <div class="flex-1 flex flex-col justify-between gap-3 overflow-hidden">
    <!-- Header Banner -->
    <div class="flex items-center justify-between border-b-2 border-black dark:border-white pb-2.5">
      <div>
        <span class="text-xs font-mono font-bold tracking-widest text-accent uppercase">Executive Portfolio Summary</span>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black leading-tight tracking-tight">
          Bayu Rizky Kurnia Pratama
        </h1>
      </div>
      <div class="text-right">
        <div class="inline-block px-2.5 py-1 bg-accent text-black font-mono font-bold text-xs border border-black dark:border-white shadow-neo-sm">
          Tabanan, Bali • GPA 3.93 / 4.0
        </div>
        <p class="text-xs font-body opacity-70 mt-1">Backend Engineer & Systems Architect</p>
      </div>
    </div>

    <!-- 16:9 Master Bento Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 grid-rows-1 lg:grid-rows-6 gap-3 flex-1 min-h-0">
      
      <!-- Bento 1: Profile & Bio Summary (Cols 1-4, Rows 1-6) -->
      <div
        class="lg:col-span-4 lg:row-span-6 border-2 border-black dark:border-white bg-neutral-50 dark:bg-neutral-900/60 p-4 shadow-neo-sm dark:shadow-neo-dark-sm flex flex-col justify-between relative overflow-hidden group"
      >
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <img
              src="/images/bay-1.jpeg"
              alt="Bayu Pratama"
              class="w-14 h-14 object-cover border-2 border-black dark:border-white shadow-neo-sm grayscale group-hover:grayscale-0 transition-all"
            />
            <div>
              <h2 class="font-heading font-bold text-base leading-tight">Backend & System Design</h2>
              <p class="font-mono text-xs text-accent font-bold">Node.js • PHP • Go • AI/LLM</p>
            </div>
          </div>
          <p class="text-xs sm:text-[13px] font-body leading-relaxed opacity-90">
            Backend Engineer specializing in resilient distributed systems, offline-first architectures, virtual economies, and LLM integrations. Author of peer-reviewed research in <em>Buletin Teknologi Informasi</em>.
          </p>
          <div class="border-t border-black/20 dark:border-white/20 pt-2 space-y-1.5 text-xs font-mono">
            <div class="flex justify-between">
              <span class="opacity-60">Education:</span>
              <span class="font-bold">Udayana Univ (CS/IT)</span>
            </div>
            <div class="flex justify-between">
              <span class="opacity-60">Current Role:</span>
              <span class="font-bold text-accent">Fullstack Dev @ Kaimify</span>
            </div>
            <div class="flex justify-between">
              <span class="opacity-60">Honor:</span>
              <span class="font-bold">BAZNAS National Scholar</span>
            </div>
          </div>
        </div>

        <a
          href="/summary/skills"
          class="w-full mt-3 py-1.5 px-3 bg-black dark:bg-white text-white dark:text-black font-heading font-bold text-xs text-center border border-black hover:bg-accent hover:text-black transition-colors flex items-center justify-center gap-1.5"
        >
          View Full Skill Matrix <span>→</span>
        </a>
      </div>

      <!-- Bento 2: Featured Projects Hero (Cols 5-8, Rows 1-3) -> Links to /summary/projects -->
      <a
        href="/summary/projects"
        class="lg:col-span-4 lg:row-span-3 border-2 border-black dark:border-white bg-[#FFF9E6] dark:bg-neutral-900 p-4 shadow-neo-sm dark:shadow-neo-dark-sm hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all flex flex-col justify-between group cursor-pointer"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
              01 • FEATURED PROJECTS
            </span>
            <span class="text-xs font-mono font-bold text-accent group-hover:translate-x-1 transition-transform">
              10 Projects →
            </span>
          </div>
          <h3 class="font-heading font-bold text-base group-hover:text-accent transition-colors">
            Production & Research Systems
          </h3>
          <p class="text-xs font-body opacity-80 mt-1 line-clamp-2">
            Niagara POS (Offline-First Clean Architecture), Kaimify (Harm-reduction Dual Currency), Moodyan (ICP Web3), and KSH Multi-Region.
          </p>
        </div>
        <div class="flex flex-wrap gap-1 mt-2">
          <span class="px-1.5 py-0.5 text-[10px] font-mono font-bold bg-white dark:bg-black border border-black dark:border-white">Clean Arch</span>
          <span class="px-1.5 py-0.5 text-[10px] font-mono font-bold bg-white dark:bg-black border border-black dark:border-white">SQLite/Supabase</span>
          <span class="px-1.5 py-0.5 text-[10px] font-mono font-bold bg-white dark:bg-black border border-black dark:border-white">NestJS</span>
          <span class="px-1.5 py-0.5 text-[10px] font-mono font-bold bg-white dark:bg-black border border-black dark:border-white">Web3 ICP</span>
        </div>
      </a>

      <!-- Bento 3: Tech Stack & Architecture (Cols 9-12, Rows 1-3) -> Links to /summary/skills -->
      <a
        href="/summary/skills"
        class="lg:col-span-4 lg:row-span-3 border-2 border-black dark:border-white bg-[#EBF5FB] dark:bg-neutral-900 p-4 shadow-neo-sm dark:shadow-neo-dark-sm hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all flex flex-col justify-between group cursor-pointer"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
              02 • CORE TECH STACK
            </span>
            <span class="text-xs font-mono font-bold text-accent group-hover:translate-x-1 transition-transform">
              Explore →
            </span>
          </div>
          <h3 class="font-heading font-bold text-base group-hover:text-accent transition-colors">
            Full-Spectrum Engineering
          </h3>
          <p class="text-xs font-body opacity-80 mt-1 line-clamp-2">
            NestJS, Express, Laravel, Go, Flutter, React, Next.js, PostgreSQL, Drizzle ORM, GCP, Docker, & LLMs.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-1 mt-2 text-[11px] font-mono">
          <div class="bg-white/80 dark:bg-black/60 px-1.5 py-0.5 border border-black/30 dark:border-white/30 truncate">⚡ Nest / Laravel</div>
          <div class="bg-white/80 dark:bg-black/60 px-1.5 py-0.5 border border-black/30 dark:border-white/30 truncate">📱 Flutter / React</div>
          <div class="bg-white/80 dark:bg-black/60 px-1.5 py-0.5 border border-black/30 dark:border-white/30 truncate">🗄️ PostgreSQL/Drizzle</div>
          <div class="bg-white/80 dark:bg-black/60 px-1.5 py-0.5 border border-black/30 dark:border-white/30 truncate">🤖 LLM & Web3</div>
        </div>
      </a>

      <!-- Bento 4: Career & Leadership Timeline (Cols 5-8, Rows 4-6) -> Links to /summary/experience -->
      <a
        href="/summary/experience"
        class="lg:col-span-4 lg:row-span-3 border-2 border-black dark:border-white bg-[#EAFaf1] dark:bg-neutral-900 p-4 shadow-neo-sm dark:shadow-neo-dark-sm hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all flex flex-col justify-between group cursor-pointer"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
              03 • EXPERIENCE
            </span>
            <span class="text-xs font-mono font-bold text-accent group-hover:translate-x-1 transition-transform">
              Timeline →
            </span>
          </div>
          <h3 class="font-heading font-bold text-base group-hover:text-accent transition-colors">
            Industry & Research Roles
          </h3>
          <p class="text-xs font-body opacity-80 mt-1 line-clamp-2">
            Fullstack Dev (Kaimify), Programming Teacher & Intern (Timedoor), POS Researcher, Bangkit Top 10%, Head TA.
          </p>
        </div>
        <div class="border-t border-black/20 dark:border-white/20 pt-1.5 flex items-center justify-between text-xs font-mono">
          <span class="text-accent font-bold">7 Key Milestones</span>
          <span class="opacity-60">2023 - Present</span>
        </div>
      </a>

      <!-- Bento 5: Awards & Honors (Cols 9-12, Rows 4-6) -> Links to /summary/awards -->
      <a
        href="/summary/awards"
        class="lg:col-span-4 lg:row-span-3 border-2 border-black dark:border-white bg-[#FDEDEC] dark:bg-neutral-900 p-4 shadow-neo-sm dark:shadow-neo-dark-sm hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all flex flex-col justify-between group cursor-pointer"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold px-2 py-0.5 bg-black text-white dark:bg-white dark:text-black">
              04 • HONORS & RESEARCH
            </span>
            <span class="text-xs font-mono font-bold text-accent group-hover:translate-x-1 transition-transform">
              Accolades →
            </span>
          </div>
          <h3 class="font-heading font-bold text-base group-hover:text-accent transition-colors">
            Hackathons & Publications
          </h3>
          <p class="text-xs font-body opacity-80 mt-1 line-clamp-2">
            1st Place ICP Web3 Hackathon, 3rd Place PNB IT Competition, Beasiswa Cendekia BAZNAS Awardee & BTI Research Paper.
          </p>
        </div>
        <div class="flex items-center gap-1.5 mt-2">
          <span class="px-2 py-0.5 bg-accent text-black font-mono font-bold text-[10px] border border-black">🏆 1st ICP Web3</span>
          <span class="px-2 py-0.5 bg-white dark:bg-black font-mono font-bold text-[10px] border border-black dark:border-white">🎓 BAZNAS Scholar</span>
        </div>
      </a>

    </div>
  </div>
</SummaryLayout>
