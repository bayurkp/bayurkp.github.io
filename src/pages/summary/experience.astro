---
import SummaryLayout from '../../layouts/SummaryLayout.astro';

const experiences = [
  {
    period: 'Jul 2026 – Present',
    title: 'Software Engineer',
    company: 'Self-employed',
    description:
      'Engineered multi-region platforms (KSH) and academic systems (SIM-PKMTI) with Next.js 15, React 18, and Laravel 10.',
    stack: ['Next.js 15', 'Laravel 10', 'React 18'],
    darkCard: true,
  },
  {
    period: '2026 – Present',
    title: 'Fullstack Developer',
    company: 'Kaimify',
    description:
      'Building backend microservices in NestJS & PostgreSQL with dual-currency transactional ledgers.',
    stack: ['NestJS', 'PostgreSQL', 'Flutter'],
    darkCard: false,
  },
  {
    period: 'Jan 2026 – Jun 2026',
    title: 'Undergraduate Researcher',
    company: 'Udayana University',
    description:
      'Architected offline-first POS with Clean Architecture, SQLite sync, and sub-20ms write latency.',
    stack: ['Flutter', 'SQLite', 'Supabase'],
    darkCard: false,
  },
  {
    period: 'Mar 2025 – Jun 2025',
    title: 'Frontend Developer Intern',
    company: 'Timedoor Indonesia',
    description:
      'Developed Vue.js web interfaces, integrated REST APIs, and resolved 100+ UI & logic issues.',
    stack: ['Vue.js', 'REST API', 'Git'],
    darkCard: false,
  },
  {
    period: 'Aug 2024 – Present',
    title: 'Programming Teacher',
    company: 'Timedoor Academy',
    description:
      'Delivering bilingual instruction in Python, Machine Learning, AI algorithms, and Vue.js fundamentals.',
    stack: ['Python', 'Teaching', 'Vue.js'],
    darkCard: false,
  },
  {
    period: 'Feb 2024 – Jul 2024',
    title: 'Cloud Computing Cohort',
    company: 'Bangkit Academy',
    description:
      'Built Google Cloud infrastructure. Led team of 7 to Top 50 Capstone ranking out of 644 national teams.',
    stack: ['GCP', 'Docker', 'Express'],
    darkCard: false,
  },
  {
    period: 'Sep 2023 – Jun 2024',
    title: 'Teaching Assistant',
    company: 'Udayana University',
    description:
      'Instructed C/C++ Algorithms & Programming and Database Concepts (MySQL, ERD, PDM).',
    stack: ['C/C++', 'Algorithms', 'MySQL'],
    darkCard: false,
  },
  {
    period: 'Jan 2024 – Dec 2024',
    title: 'Vice Chairman',
    company: 'Technology Artisan',
    description:
      'Coordinated technical programs across 6 engineering divisions in student developer community.',
    stack: ['Leadership', 'Teamwork'],
    darkCard: false,
  },
];
---

<SummaryLayout
  title="Experience"
  slideNumber={4}
  totalSlides={6}
  currentSlug="/summary/experience"
  prevSlug="/summary/skills"
  nextSlug="/summary/awards"
>
  <div class="flex-1 flex flex-col justify-between overflow-hidden">
    <!-- Header -->
    <div
      class="h-16 sm:h-[68px] flex items-center justify-between border-b-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-5 shrink-0"
    >
      <div>
        <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider"
          >04 • Career</span
        >
        <h1
          class="text-xl sm:text-2xl font-heading font-black text-black dark:text-white leading-tight"
        >
          Where I've Worked
        </h1>
      </div>
      <div class="text-xs font-mono text-zinc-500">
        Industry • Research • Education • Leadership
      </div>
    </div>

    <!-- 4x2 Grid (8 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 flex-1 min-h-0">
      {
        experiences.map((exp, idx) => {
          const isRightCol = (idx + 1) % 4 === 0;
          const isBottomRow = idx >= 4;
          const borderClasses = [
            !isRightCol ? 'lg:border-r-2' : '',
            !isBottomRow ? 'border-b-2' : '',
            idx % 2 === 0 ? 'md:border-r-2 lg:border-r-0' : '',
            'border-black dark:border-white',
          ]
            .filter(Boolean)
            .join(' ');

          const bgClass = exp.darkCard
            ? 'bg-zinc-900 dark:bg-black text-white'
            : 'bg-white dark:bg-zinc-900 text-black dark:text-white';

          const titleColor = exp.darkCard ? 'text-white' : 'text-black dark:text-white';
          const descColor = exp.darkCard ? 'text-zinc-300' : 'text-zinc-600 dark:text-zinc-400';
          const periodColor = exp.darkCard ? 'text-zinc-400' : 'text-zinc-500';
          const borderDivider = exp.darkCard
            ? 'border-white/15'
            : 'border-black/10 dark:border-white/10';
          const stackColor = exp.darkCard ? 'text-zinc-400' : 'text-zinc-500';

          return (
            <div class={`${bgClass} ${borderClasses} p-4 flex flex-col justify-between`}>
              <div>
                <span class={`text-[10px] font-mono ${periodColor}`}>{exp.period}</span>
                <h2
                  class={`font-heading font-bold text-sm sm:text-base ${titleColor} mt-0.5 leading-snug`}
                >
                  {exp.title}
                </h2>
                <p class="text-xs font-mono text-accent font-semibold">{exp.company}</p>
                <p class={`text-xs font-body ${descColor} mt-2 leading-relaxed`}>
                  {exp.description}
                </p>
              </div>
              <div
                class={`text-[11px] font-mono pt-2 border-t mt-2 flex items-center gap-1.5 flex-wrap ${borderDivider} ${stackColor}`}
              >
                {exp.stack.map((s, sIdx) => (
                  <>
                    <span
                      class={
                        exp.darkCard
                          ? 'text-zinc-200 font-bold'
                          : 'text-zinc-700 dark:text-zinc-300 font-bold'
                      }
                    >
                      {s}
                    </span>
                    {sIdx < exp.stack.length - 1 && <span>•</span>}
                  </>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</SummaryLayout>
