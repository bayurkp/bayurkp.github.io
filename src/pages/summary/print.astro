---
import '../../styles/global.css';

const projects = [
  {
    title: 'Niagara POS',
    tagline: 'Offline-First Point of Sale',
    description: 'Clean Architecture with bilateral SQLite-to-Supabase sync, FIFO transaction queues, and sub-20ms local write latency.',
    stack: ['Flutter', 'SQLite', 'Supabase'],
    stat: '<20ms Latency',
    darkCard: false,
    accentCard: false,
  },
  {
    title: 'Kaimify',
    tagline: 'Mindfulness & Habit App',
    description: 'Harm-reduction platform with dual-currency transactional ledger, 2D room decorator, and AdMob server-side verification.',
    stack: ['NestJS', 'PostgreSQL', 'Drizzle ORM'],
    stat: 'Dual-Currency ACID',
    darkCard: true,
    accentCard: false,
  },
  {
    title: 'Kelompok Setia Hati',
    tagline: 'Multi-Region Community',
    description: '6-tier Spatie RBAC, automated serial PDF certificate generation, and regional donation ledger tracking.',
    stack: ['Next.js 15', 'Laravel 10', 'MySQL'],
    stat: '6-Tier RBAC',
    darkCard: false,
    accentCard: false,
  },
  {
    title: 'Memotions',
    tagline: 'AI Emotion Journal',
    description: 'GCP Cloud Run backend with Pub/Sub ML inference pipelines. Ranked Top 50 out of 644 national teams.',
    stack: ['Express', 'GCP Run', 'Drizzle'],
    stat: 'Top 50 / 644 Teams',
    darkCard: false,
    accentCard: false,
  },
  {
    title: 'Moodyan',
    tagline: 'Web3 On-Chain Journal',
    description: 'Decentralized wellness log on Internet Computer Protocol (ICP) with Motoko canisters, Internet Identity, and local LLM analysis.',
    stack: ['ICP', 'Motoko', 'React'],
    stat: '1st Place ICP Hub',
    darkCard: false,
    accentCard: true,
  },
  {
    title: 'TemanTaman',
    tagline: 'Agricultural Marketplace',
    description: 'Real-time bidding and escrow settlement platform connecting ornamental plant growers directly to buyers.',
    stack: ['Laravel', 'MySQL', 'Tailwind'],
    stat: '3rd Place PNB #16',
    darkCard: false,
    accentCard: false,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bayu Pratama — Summary Deck (6 Slides Print & PDF)</title>
    <meta name="description" content="Bayu Rizky Kurnia Pratama 6-Slide Summary Deck" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      @media print {
        @page {
          size: 16in 9in;
          margin: 0;
        }
        html, body {
          margin: 0 !important;
          padding: 0 !important;
          background: #ffffff !important;
          color: #000000 !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        .slide-page {
          width: 16in !important;
          height: 9in !important;
          page-break-after: always !important;
          break-after: page !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          padding: 0.4in !important;
          box-sizing: border-box !important;
          display: flex !important;
          flex-direction: column !important;
          justify-content: center !important;
        }
        .no-print {
          display: none !important;
        }
      }
      @media screen {
        .slide-page {
          width: 100%;
          max-width: 1400px;
          aspect-ratio: 16/9;
          margin: 2rem auto;
          box-sizing: border-box;
          display: flex;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body class="bg-[#F0F0F3] dark:bg-[#0C0C0E] text-black dark:text-white font-body antialiased">
    
    <!-- Top Action Bar for User Screen -->
    <div class="no-print sticky top-0 z-50 bg-black text-white p-3 border-b-2 border-white flex items-center justify-between font-mono text-xs shadow-lg">
      <div class="flex items-center gap-3">
        <a href="/summary" class="px-3 py-1.5 bg-white text-black font-bold hover:bg-accent transition-colors flex items-center gap-1.5">
          ← Back to Deck
        </a>
        <span class="hidden sm:inline opacity-70">Complete 6-Slide Printable View</span>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/cv/CV_Bayu_Rizky_Kurnia_Pratama.pdf"
          download="CV_Bayu_Rizky_Kurnia_Pratama.pdf"
          class="px-3 py-1.5 bg-zinc-800 text-white border border-white/30 font-bold hover:bg-accent hover:text-black transition-colors"
        >
          Download CV (PDF) ↓
        </a>
        <button
          onclick="window.print()"
          class="px-4 py-1.5 bg-accent text-black font-bold hover:bg-white transition-colors cursor-pointer"
        >
          🖨️ Print / Save All 6 Slides as PDF
        </button>
      </div>
    </div>

    <div class="p-2 sm:p-4">

      <!-- ================= SLIDE 1: OVERVIEW ================= -->
      <section class="slide-page">
        <div class="w-full h-full bg-white dark:bg-[#121215] border-3 border-black dark:border-white flex flex-col justify-between overflow-hidden shadow-2xl">
          <div class="flex-1 grid grid-cols-12 min-h-0 divide-x-2 divide-black dark:divide-white">
            <!-- PANEL A: Photo Card -->
            <div class="col-span-3 relative overflow-hidden bg-zinc-900 flex flex-col">
              <img src="/images/bay-1.jpeg" alt="Bayu Pratama" class="absolute inset-0 w-full h-full object-cover object-[42%_center] grayscale contrast-125 opacity-70" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
              <div class="relative flex flex-col justify-end h-full p-5 gap-1">
                <p class="font-mono text-xs text-accent font-bold uppercase tracking-widest">01 • Profile</p>
                <h1 class="text-xl font-heading font-black text-white leading-tight">Bayu Rizky<br/>Kurnia Pratama</h1>
                <p class="text-[11px] font-mono text-zinc-300 mt-0.5">Software Engineer</p>
                <p class="text-[10px] font-mono text-accent">Fullstack • Backend • AI Integration</p>
              </div>
            </div>

            <!-- Right 9 Columns -->
            <div class="col-span-9 grid grid-cols-3 grid-rows-2 divide-y-2 divide-black dark:divide-white">
              <!-- B: Big Stat -->
              <div class="bg-accent p-5 flex flex-col justify-between border-r-2 border-black">
                <div class="flex items-start justify-between">
                  <span class="font-mono text-xs font-bold text-black uppercase tracking-widest">Projects Shipped</span>
                  <svg class="w-5 h-5 text-black/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                </div>
                <div>
                  <div class="text-5xl font-heading font-black text-black leading-none">10+</div>
                  <p class="text-xs font-mono text-black/70 mt-1">Production & research systems</p>
                </div>
              </div>

              <!-- C: Bio Text -->
              <div class="bg-white dark:bg-zinc-900 p-5 flex flex-col justify-between border-r-2 border-black dark:border-white">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest">02 • Work</span>
                  </div>
                  <h2 class="text-xl font-heading font-black text-black dark:text-white">Featured Projects</h2>
                  <p class="text-xs font-body text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
                    Offline-first POS, dual-currency wellness app, decentralized Web3 journal, and enterprise community platforms.
                  </p>
                </div>
                <div class="text-[11px] font-mono text-zinc-500 mt-3">Niagara POS • Kaimify • Moodyan • KSH</div>
              </div>

              <!-- D: Wins -->
              <div class="bg-zinc-900 dark:bg-black p-5 flex flex-col justify-between border-black dark:border-white">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest">05 • Wins</span>
                  <svg class="w-5 h-5 text-zinc-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
                </div>
                <div>
                  <div class="text-4xl font-heading font-black text-white leading-none">1st Place</div>
                  <p class="text-xs font-mono text-accent mt-1 font-bold">ICP Indonesia Hackathon</p>
                  <p class="text-xs font-mono text-zinc-500 mt-0.5">+ BAZNAS National Scholar</p>
                </div>
              </div>

              <!-- E: About / Bio -->
              <div class="bg-white dark:bg-zinc-900 p-5 flex flex-col justify-between border-r-2 border-black dark:border-white">
                <div>
                  <p class="text-sm font-body text-zinc-700 dark:text-zinc-300 leading-relaxed">
                    I design and build backend services — APIs, data sync engines, transactional ledgers, and LLM integrations. Focused on systems that work reliably offline and at scale.
                  </p>
                </div>
                <div class="pt-3 border-t border-black/10 dark:border-white/10 flex items-center justify-between text-xs font-mono">
                  <span class="text-zinc-500">Current Role</span>
                  <span class="font-bold text-black dark:text-white">Fullstack Dev @ Kaimify</span>
                </div>
              </div>

              <!-- F: Tech Grid -->
              <div class="bg-white dark:bg-zinc-900 p-5 flex flex-col justify-between border-r-2 border-black dark:border-white">
                <div class="flex items-center justify-between mb-3">
                  <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest">03 • Stack</span>
                </div>
                <div class="grid grid-cols-2 gap-1.5 font-mono text-xs font-bold flex-1">
                  {['NestJS', 'Node.js', 'Laravel', 'Go', 'Flutter', 'PostgreSQL', 'SQLite', 'Docker'].map(t => (
                    <div class="px-2 py-1.5 bg-zinc-100 dark:bg-zinc-800 border border-black/15 dark:border-white/15 truncate">{t}</div>
                  ))}
                </div>
              </div>

              <!-- G: Experience -->
              <div class="bg-white dark:bg-zinc-900 p-5 flex flex-col justify-between border-black dark:border-white">
                <div class="flex items-center justify-between mb-3">
                  <span class="font-mono text-xs font-bold text-accent uppercase tracking-widest">04 • Career</span>
                </div>
                <div class="space-y-1.5 flex-1">
                  {[
                    { role: 'Kaimify', label: 'Fullstack Dev', year: '2026', active: true },
                    { role: 'Timedoor', label: 'Programming Teacher', year: '2024', active: false },
                    { role: 'Bangkit', label: 'Cloud Computing — Top 10%', year: '2024', active: false },
                  ].map(e => (
                    <div class={`flex items-center justify-between px-2.5 py-1.5 border font-mono text-xs ${e.active ? 'bg-accent text-black border-black' : 'bg-zinc-100 dark:bg-zinc-800 border-black/15 dark:border-white/15 text-black dark:text-white'}`}>
                      <span class="font-bold truncate">{e.role}</span>
                      <span class={`text-[10px] ${e.active ? 'text-black' : 'text-zinc-500'}`}>{e.year}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Slide Footer -->
          <footer class="border-t-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-4 py-1.5 flex items-center justify-between text-xs font-mono shrink-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-black dark:text-white">Bayu Pratama</span>
              <span class="opacity-40">•</span>
              <span class="opacity-60">Software Engineer</span>
            </div>
            <span class="font-bold text-xs px-2 py-0.5 bg-black dark:bg-white text-white dark:text-black">1 / 6</span>
          </footer>
        </div>
      </section>

      <!-- ================= SLIDE 2: PROJECTS ================= -->
      <section class="slide-page">
        <div class="w-full h-full bg-white dark:bg-[#121215] border-3 border-black dark:border-white flex flex-col justify-between overflow-hidden shadow-2xl">
          <!-- Header -->
          <div class="h-16 sm:h-[68px] flex items-center justify-between border-b-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-5 shrink-0">
            <div>
              <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">02 • Selected Work</span>
              <h2 class="text-xl sm:text-2xl font-heading font-black text-black dark:text-white leading-tight">Featured Projects</h2>
            </div>
            <span class="text-xs font-mono text-zinc-500">6 Production & Research Systems</span>
          </div>

          <!-- 2x3 Grid -->
          <div class="grid grid-cols-3 flex-1 min-h-0">
            {projects.map((p, idx) => {
              const isRightCol = (idx + 1) % 3 === 0;
              const isBottomRow = idx >= 3;
              const borderClasses = [
                !isRightCol ? 'border-r-2' : '',
                !isBottomRow ? 'border-b-2' : '',
                'border-black dark:border-white',
              ].filter(Boolean).join(' ');

              const bgClass = p.accentCard ? 'bg-accent' : p.darkCard ? 'bg-zinc-900 dark:bg-black' : 'bg-white dark:bg-zinc-900';
              const titleColor = p.accentCard ? 'text-black' : p.darkCard ? 'text-white' : 'text-black dark:text-white';
              const descColor = p.accentCard ? 'text-black/75' : p.darkCard ? 'text-zinc-400' : 'text-zinc-700 dark:text-zinc-300';
              const tagColor = p.accentCard ? 'text-black/60' : 'text-accent';
              const statBg = p.accentCard ? 'bg-black/15 text-black border border-black/30' : p.darkCard ? 'bg-white/10 text-white border border-white/20' : 'bg-zinc-100 dark:bg-zinc-800 text-black dark:text-white border border-black/15 dark:border-white/15';

              return (
                <div class={`${bgClass} ${borderClasses} p-5 flex flex-col justify-between`}>
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <div>
                        <h3 class={`font-heading font-bold text-lg leading-tight ${titleColor}`}>{p.title}</h3>
                        <p class={`text-xs font-mono font-semibold mt-0.5 ${tagColor}`}>{p.tagline}</p>
                      </div>
                      <span class={`px-2 py-0.5 font-mono font-bold text-[10px] whitespace-nowrap ${statBg}`}>{p.stat}</span>
                    </div>
                    <p class={`text-xs sm:text-[13px] font-body leading-relaxed mt-2 ${descColor}`}>{p.description}</p>
                  </div>
                  <div class="flex items-center gap-1.5 pt-3 mt-3 border-t border-black/10 dark:border-white/10 font-mono text-[11px] text-zinc-500">
                    {p.stack.map((tech, tIdx) => (
                      <>
                        <span class="font-bold text-black dark:text-white">{tech}</span>
                        {tIdx < p.stack.length - 1 && <span>•</span>}
                      </>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

          <!-- Slide Footer -->
          <footer class="border-t-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-4 py-1.5 flex items-center justify-between text-xs font-mono shrink-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-black dark:text-white">Bayu Pratama</span>
              <span class="opacity-40">•</span>
              <span class="opacity-60">Software Engineer</span>
            </div>
            <span class="font-bold text-xs px-2 py-0.5 bg-black dark:bg-white text-white dark:text-black">2 / 6</span>
          </footer>
        </div>
      </section>

      <!-- ================= SLIDE 3: STACK ================= -->
      <section class="slide-page">
        <div class="w-full h-full bg-white dark:bg-[#121215] border-3 border-black dark:border-white flex flex-col justify-between overflow-hidden shadow-2xl">
          <!-- Header -->
          <div class="h-16 sm:h-[68px] flex items-center justify-between border-b-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-5 shrink-0">
            <div>
              <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">03 • Core Tools</span>
              <h2 class="text-xl sm:text-2xl font-heading font-black text-black dark:text-white leading-tight">Technical Stack</h2>
            </div>
            <div class="text-xs font-mono text-zinc-500">Backend-First Development</div>
          </div>

          <!-- 4 Quadrants -->
          <div class="grid grid-cols-2 flex-1 min-h-0 divide-x-2 divide-black dark:divide-white">
            <!-- Left Column -->
            <div class="flex flex-col divide-y-2 divide-black dark:divide-white">
              <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
                <div>
                  <h3 class="font-heading font-bold text-xl text-black dark:text-white mb-2">Backend Development</h3>
                  <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">Building scalable REST APIs, background job workers, and business logic using Node.js, Go, and PHP.</p>
                </div>
                <div class="flex flex-wrap gap-2 font-mono text-xs">
                  {['NestJS', 'Node.js', 'Laravel', 'Go', 'TypeScript', 'Python'].map(t => (
                    <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold">{t}</span>
                  ))}
                </div>
              </div>
              <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
                <div>
                  <h3 class="font-heading font-bold text-xl text-black dark:text-white mb-2">Databases & DevOps</h3>
                  <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">Relational schemas with Drizzle ORM, offline SQLite caching, Docker containers, and Google Cloud Run.</p>
                </div>
                <div class="flex flex-wrap gap-2 font-mono text-xs">
                  {['PostgreSQL', 'SQLite', 'Supabase', 'Drizzle ORM', 'Docker', 'Google Cloud'].map(t => (
                    <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold">{t}</span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Column -->
            <div class="flex flex-col divide-y-2 divide-black dark:divide-white">
              <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
                <div>
                  <h3 class="font-heading font-bold text-xl text-black dark:text-white mb-2">Frontend & Mobile</h3>
                  <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">Cross-platform mobile applications in Flutter, and modern responsive web interfaces in React and Next.js.</p>
                </div>
                <div class="flex flex-wrap gap-2 font-mono text-xs">
                  {['Flutter', 'Dart', 'React', 'Next.js 15', 'Vue.js', 'Tailwind CSS'].map(t => (
                    <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold">{t}</span>
                  ))}
                </div>
              </div>
              <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
                <div>
                  <h3 class="font-heading font-bold text-xl text-black dark:text-white mb-2">Architectural Focus</h3>
                  <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">Core architectural patterns implemented and battle-tested across production applications.</p>
                </div>
                <div class="flex flex-wrap gap-2 font-mono text-xs">
                  {['Offline-First Data Sync', 'Dual-Currency Ledgers', 'Model Context Protocol (MCP)', 'Clean Architecture'].map(t => (
                    <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Slide Footer -->
          <footer class="border-t-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-4 py-1.5 flex items-center justify-between text-xs font-mono shrink-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-black dark:text-white">Bayu Pratama</span>
              <span class="opacity-40">•</span>
              <span class="opacity-60">Software Engineer</span>
            </div>
            <span class="font-bold text-xs px-2 py-0.5 bg-black dark:bg-white text-white dark:text-black">3 / 6</span>
          </footer>
        </div>
      </section>

      <!-- ================= SLIDE 4: EXPERIENCE ================= -->
      <section class="slide-page">
        <div class="w-full h-full bg-white dark:bg-[#121215] border-3 border-black dark:border-white flex flex-col justify-between overflow-hidden shadow-2xl">
          <!-- Header -->
          <div class="h-16 sm:h-[68px] flex items-center justify-between border-b-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-5 shrink-0">
            <div>
              <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">04 • Career</span>
              <h2 class="text-xl sm:text-2xl font-heading font-black text-black dark:text-white leading-tight">Where I've Worked</h2>
            </div>
            <div class="text-xs font-mono text-zinc-500">Industry • Research • Education • Leadership</div>
          </div>

          <!-- 10-Cell Grid -->
          <div class="grid grid-cols-5 flex-1 min-h-0">
            <!-- Row 1 -->
            <div class="bg-zinc-900 dark:bg-black p-4 flex flex-col justify-between border-b-2 border-r-2 border-black dark:border-white text-white">
              <div>
                <span class="text-[10px] font-mono text-zinc-400">2026 – Present</span>
                <h3 class="font-heading font-bold text-sm text-white mt-0.5">Fullstack Developer</h3>
                <p class="text-xs font-mono text-accent font-semibold">Kaimify</p>
                <p class="text-xs font-body text-zinc-300 mt-2 leading-relaxed">Building backend microservices in NestJS & PostgreSQL with dual-currency transactional ledgers.</p>
              </div>
              <div class="text-[11px] font-mono text-zinc-400 pt-2 border-t border-white/15">NestJS • Drizzle • Flutter</div>
            </div>

            <div class="bg-accent flex items-center justify-center p-4 border-b-2 border-r-2 border-black">
              <svg class="w-16 h-16 text-black" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
            </div>

            <div class="bg-white dark:bg-zinc-900 p-4 flex flex-col justify-between border-b-2 border-r-2 border-black dark:border-white">
