---
import SummaryLayout from '../../layouts/SummaryLayout.astro';
---

<SummaryLayout
  title="Stack"
  slideNumber={3}
  totalSlides={6}
  currentSlug="/summary/skills"
  prevSlug="/summary/projects"
  nextSlug="/summary/experience"
>
  <div class="flex-1 flex flex-col justify-between overflow-hidden">
    <!-- Header -->
    <div
      class="h-16 sm:h-[68px] flex items-center justify-between border-b-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-5 shrink-0"
    >
      <div>
        <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider"
          >03 • Core Tools</span
        >
        <h1
          class="text-xl sm:text-2xl font-heading font-black text-black dark:text-white leading-tight"
        >
          Technical Stack
        </h1>
      </div>
      <div class="text-xs font-mono text-zinc-500">Backend-First Development</div>
    </div>

    <!-- 16:9 4-Quadrant Matrix -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 flex-1 min-h-0 divide-y-2 sm:divide-y-0 sm:divide-x-2 divide-black dark:divide-white"
    >
      <!-- Left Column -->
      <div class="flex flex-col divide-y-2 divide-black dark:divide-white">
        <!-- Quadrant 1: Backend Development -->
        <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
          <div>
            <h2 class="font-heading font-bold text-xl text-black dark:text-white mb-2">
              Backend Development
            </h2>
            <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Building scalable REST APIs, background job workers, and business logic using Node.js,
              Go, and PHP.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >NestJS</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Node.js</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Laravel</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Go</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >TypeScript</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Python</span
            >
          </div>
        </div>

        <!-- Quadrant 3: Databases & DevOps -->
        <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
          <div>
            <h2 class="font-heading font-bold text-xl text-black dark:text-white mb-2">
              Databases & DevOps
            </h2>
            <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Relational schemas with Drizzle ORM, offline SQLite caching, Docker containers, and
              Google Cloud Run.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >PostgreSQL</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >SQLite</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Supabase</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Drizzle ORM</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Docker</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Google Cloud</span
            >
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="flex flex-col divide-y-2 divide-black dark:divide-white">
        <!-- Quadrant 2: Frontend & Mobile -->
        <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
          <div>
            <h2 class="font-heading font-bold text-xl text-black dark:text-white mb-2">
              Frontend & Mobile
            </h2>
            <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Cross-platform mobile applications in Flutter, and modern responsive web interfaces in
              React and Next.js.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Flutter</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Dart</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >React</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Next.js 15</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Vue.js</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Tailwind CSS</span
            >
          </div>
        </div>

        <!-- Quadrant 4: Architectural Focus -->
        <div class="flex-1 bg-white dark:bg-zinc-900 p-6 flex flex-col justify-between">
          <div>
            <h2 class="font-heading font-bold text-xl text-black dark:text-white mb-2">
              Architectural Focus
            </h2>
            <p class="text-sm font-body text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Core architectural patterns implemented and battle-tested across production
              applications.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Offline-First Data Sync</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Dual-Currency Ledgers</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Model Context Protocol (MCP)</span
            >
            <span
              class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 border border-black/20 dark:border-white/20 font-bold"
              >Clean Architecture</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</SummaryLayout>
