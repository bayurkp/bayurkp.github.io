---
import SummaryLayout from '../../layouts/SummaryLayout.astro';
---

<SummaryLayout
  title="Contact"
  slideNumber={6}
  totalSlides={6}
  currentSlug="/summary/contact"
  prevSlug="/summary/awards"
  nextSlug="/summary"
>
  <div class="flex-1 flex flex-col justify-between overflow-hidden">
    <!-- Header -->
    <div
      class="h-16 sm:h-[68px] flex items-center justify-between border-b-2 border-black dark:border-white bg-zinc-50 dark:bg-zinc-900 px-5 shrink-0"
    >
      <div>
        <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider"
          >06 • Connect</span
        >
        <h1
          class="text-xl sm:text-2xl font-heading font-black text-black dark:text-white leading-tight"
        >
          Get in Touch
        </h1>
      </div>
      <div class="text-xs font-mono text-zinc-500">Let's Discuss Projects & Opportunities</div>
    </div>

    <!-- 16:9 Contact Grid -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 flex-1 min-h-0 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-black dark:divide-white"
    >
      <!-- Form (Cols 1-7) -->
      <div class="lg:col-span-7 bg-white dark:bg-zinc-900 p-5 sm:p-6 flex flex-col justify-between overflow-hidden">
        <div>
          <h2 class="font-heading font-bold text-base sm:text-lg text-black dark:text-white mb-2.5">
            Send a Direct Message
          </h2>
          <form
            action="https://formsubmit.co/bayurkp194@gmail.com"
            method="POST"
            class="space-y-2.5 text-xs font-mono"
          >
            <input type="hidden" name="_subject" value="New Inquiry from 16:9 Portfolio Deck" />
            <input type="hidden" name="_captcha" value="false" />

            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label class="block font-bold mb-1 text-black dark:text-white">Name</label>
                <input
                  type="text"
                  name="name"
                  required
                  placeholder="Your Name"
                  class="w-full px-3 py-1.5 bg-zinc-50 dark:bg-zinc-800 border-2 border-black dark:border-white outline-none focus:bg-accent/10 transition-colors text-black dark:text-white text-xs"
                />
              </div>
              <div>
                <label class="block font-bold mb-1 text-black dark:text-white">Email</label>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="name@example.com"
                  class="w-full px-3 py-1.5 bg-zinc-50 dark:bg-zinc-800 border-2 border-black dark:border-white outline-none focus:bg-accent/10 transition-colors text-black dark:text-white text-xs"
                />
              </div>
            </div>

            <div>
              <label class="block font-bold mb-1 text-black dark:text-white">Message</label>
              <textarea
                name="message"
                required
                rows={3}
                placeholder="What would you like to discuss?"
                class="w-full px-3 py-1.5 bg-zinc-50 dark:bg-zinc-800 border-2 border-black dark:border-white outline-none focus:bg-accent/10 resize-none transition-colors text-black dark:text-white text-xs"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-2 bg-black dark:bg-white text-white dark:text-black font-heading font-bold text-xs border-2 border-black dark:border-white hover:bg-accent hover:text-black dark:hover:bg-accent dark:hover:text-black transition-all cursor-pointer"
            >
              Send Message →
            </button>
          </form>
        </div>
      </div>

      <!-- Direct Reach-out & Channels (Cols 8-12) -->
      <div class="lg:col-span-5 bg-white dark:bg-zinc-900 p-5 sm:p-6 flex flex-col justify-between overflow-hidden">
        <div>
          <h2 class="font-heading font-bold text-base sm:text-lg text-black dark:text-white mb-3">
            Direct Reach
          </h2>

          <div class="space-y-2 font-mono text-xs">
            <a
              href="/cv/CV_Bayu_Rizky_Kurnia_Pratama.pdf"
              download="CV_Bayu_Rizky_Kurnia_Pratama.pdf"
              class="group flex items-center justify-between p-2.5 bg-accent text-black border-2 border-black dark:border-white font-bold hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors"
            >
              <span class="flex items-center gap-1.5 font-bold">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                Curriculum Vitae
              </span>
              <span class="text-[11px] font-mono">Download PDF ↓</span>
            </a>

            <a
              href="mailto:bayurkp194@gmail.com"
              class="group flex items-center justify-between p-2.5 bg-zinc-50 dark:bg-zinc-800 border-2 border-black dark:border-white hover:bg-accent hover:text-black dark:hover:bg-accent dark:hover:text-black transition-colors"
            >
              <span class="text-zinc-600 dark:text-zinc-400 group-hover:text-black dark:group-hover:text-black font-semibold">Email</span>
              <span class="font-bold text-black dark:text-white group-hover:text-black dark:group-hover:text-black">bayurkp194@gmail.com</span>
            </a>

            <a
              href="https://wa.me/62895321697691"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between p-2.5 bg-zinc-50 dark:bg-zinc-800 border-2 border-black dark:border-white hover:bg-accent hover:text-black dark:hover:bg-accent dark:hover:text-black transition-colors"
            >
              <span class="text-zinc-600 dark:text-zinc-400 group-hover:text-black dark:group-hover:text-black font-semibold">WhatsApp</span>
              <span class="font-bold text-black dark:text-white group-hover:text-black dark:group-hover:text-black">+62 895 3216 97691</span>
            </a>

            <a
              href="https://github.com/bayurkp"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between p-2.5 bg-zinc-50 dark:bg-zinc-800 border-2 border-black dark:border-white hover:bg-accent hover:text-black dark:hover:bg-accent dark:hover:text-black transition-colors"
            >
              <span class="text-zinc-600 dark:text-zinc-400 group-hover:text-black dark:group-hover:text-black font-semibold">GitHub</span>
              <span class="font-bold text-black dark:text-white group-hover:text-black dark:group-hover:text-black">github.com/bayurkp</span>
            </a>

            <div
              class="flex items-center justify-between p-2.5 bg-zinc-50 dark:bg-zinc-800 border-2 border-black dark:border-white opacity-80"
            >
              <span class="text-zinc-600 dark:text-zinc-400 font-semibold">Location</span>
              <span class="font-bold text-black dark:text-white">Bali, Indonesia</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</SummaryLayout>
