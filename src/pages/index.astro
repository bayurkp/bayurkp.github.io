---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import TechStack from '../components/TechStack.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import EducationItem from '../components/EducationItem.astro';
import AwardItem from '../components/AwardItem.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const experiences = await getCollection('experience');
const educations = await getCollection('education');
const awards = await getCollection('awards');

const featuredProjects = projects.filter((p) => p.data.featured).slice(0, 6);
const sortedBlog = blogPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const sortedExperiences = experiences.sort((a, b) => {
  if (a.data.current && !b.data.current) return -1;
  if (!a.data.current && b.data.current) return 1;
  const dateA = new Date(a.data.startDate).getTime();
  const dateB = new Date(b.data.startDate).getTime();
  return dateB - dateA;
});
---

<BaseLayout title="Home | Portfolio">
  <Hero />

  <section
    id="projects"
    class="py-16 border-b-2 border-black dark:border-white bg-neutral-light dark:bg-neutral-dark"
  >
    <div class="container mx-auto px-4">
      <div class="flex items-end justify-between mb-8">
        <h2 class="text-3xl md:text-4xl font-heading font-bold">Featured Projects</h2>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 font-heading font-bold hover:text-accent transition-colors group"
        >
          View More
          <svg
            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>
      <ProjectCarousel projects={featuredProjects} />
    </div>
  </section>

  <section id="skills" class="py-16 border-b-2 border-black dark:border-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 inline-block">Tech Stack</h2>
      <TechStack />
    </div>
  </section>

  <section
    id="experience"
    class="py-16 border-b-2 border-black dark:border-white bg-accent/5 dark:bg-accent/10"
  >
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 inline-block">Experience</h2>
      <div class="max-w-3xl mx-auto text-left">
        {
          sortedExperiences.map((exp) => (
            <ExperienceItem
              title={exp.data.title}
              company={exp.data.company}
              location={exp.data.location}
              startDate={exp.data.startDate}
              endDate={exp.data.endDate}
              current={exp.data.current}
              description={exp.data.description}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="education" class="py-16 border-b-2 border-black dark:border-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 inline-block">Education</h2>
      <div class="max-w-3xl mx-auto text-left">
        {
          educations.map((edu) => (
            <EducationItem
              degree={edu.data.degree}
              institution={edu.data.institution}
              location={edu.data.location}
              startDate={edu.data.startDate}
              endDate={edu.data.endDate}
              current={edu.data.current}
              description={edu.data.description}
            />
          ))
        }
      </div>
    </div>
  </section>

  {
    awards.length > 0 && (
      <section
        id="awards"
        class="py-16 border-b-2 border-black dark:border-white bg-neutral-light dark:bg-neutral-dark"
      >
        <div class="container mx-auto px-4 text-center">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 inline-block">
            Awards & Achievements
          </h2>
          <div class="flex flex-wrap justify-center gap-6 text-left">
            {awards.map((award) => (
              <div class="w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
                <AwardItem
                  title={award.data.title}
                  organization={award.data.organization}
                  date={award.data.date}
                  description={award.data.description}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    sortedBlog.length > 0 && (
      <section id="blog" class="py-16 border-b-2 border-black dark:border-white">
        <div class="container mx-auto px-4">
          <div class="flex items-end justify-between mb-8">
            <h2 class="text-3xl md:text-4xl font-heading font-bold">Recent Blog</h2>
            <a
              href="/blog"
              class="inline-flex items-center gap-2 font-heading font-bold hover:text-accent transition-colors group"
            >
              View More
              <svg
                class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </>
              </svg>
            </a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {sortedBlog.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date.toISOString()}
                slug={post.slug}
                tags={post.data.tags}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="contact" class="py-16 bg-neutral-light dark:bg-neutral-dark">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 inline-block">Get in Touch</h2>
      <div class="max-w-xl mx-auto text-left">
        <form action="https://formsubmit.co/bayurkp194@gmail.com" method="POST" class="space-y-6">
          <input
            type="hidden"
            name="_subject"
            value="New Portfolio Message from bayurkp.github.io"
          />
          <input type="hidden" name="_captcha" value="false" />
          <div>
            <label for="name" class="block font-heading font-bold mb-2">Name</label>
            <Input name="name" placeholder="Your name" required />
          </div>
          <div>
            <label for="email" class="block font-heading font-bold mb-2">Email</label>
            <Input name="email" type="email" placeholder="your@email.com" required />
          </div>
          <div>
            <label for="message" class="block font-heading font-bold mb-2">Message</label>
            <Input name="message" rows={5} placeholder="Your message..." required />
          </div>
          <Button type="submit" variant="primary" class="w-full">Send Message</Button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
