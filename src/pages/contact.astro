---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import Card from '../components/ui/Card.astro';
---

<BaseLayout title="Contact | Portfolio" description="Get in touch with me">
  <section class="py-16 min-h-[80vh] flex items-center">
    <div class="container mx-auto px-4 max-w-4xl">
      <h1 class="text-4xl md:text-5xl font-heading font-bold mb-4">Contact</h1>
      <p class="font-body text-lg mb-12 max-w-2xl">Have a question or want to work together? Drop me a message!</p>

      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <form action="https://formspree.io/f/your-form-id" method="POST" class="space-y-6">
            <div>
              <label for="name" class="block font-heading font-bold mb-2">Name</label>
              <Input name="name" placeholder="Your name" required />
            </div>
            <div>
              <label for="email" class="block font-heading font-bold mb-2">Email</label>
              <Input name="email" type="email" placeholder="your@email.com" required />
            </div>
            <div>
              <label for="subject" class="block font-heading font-bold mb-2">Subject</label>
              <Input name="subject" placeholder="What's this about?" required />
            </div>
            <div>
              <label for="message" class="block font-heading font-bold mb-2">Message</label>
              <Input name="message" rows={5} placeholder="Your message..." required />
            </div>
            <Button type="submit" variant="primary" class="w-full">Send Message</Button>
          </form>
        </div>

          <div class="space-y-8">
            <Card class="p-6">
              <h3 class="font-heading font-bold text-xl mb-4">Other ways to reach me</h3>
              <ul class="space-y-4 font-body">
                <li>
                  <a href="mailto:bayurkp194@gmail.com" class="flex items-center gap-3 hover:text-accent transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    bayurkp194@gmail.com
                  </a>
                </li>
                <li>
                  <a href="tel:+62895321697691" class="flex items-center gap-3 hover:text-accent transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    +62 895 3216 97691
                  </a>
                </li>
              </ul>
            </Card>
          </div>
      </div>
    </div>
  </section>
</BaseLayout>
