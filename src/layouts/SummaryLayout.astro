---
import '../styles/global.css';

interface Props {
  title: string;
  slideNumber: number;
  totalSlides?: number;
  currentSlug: string;
  prevSlug?: string;
  nextSlug?: string;
}

const {
  title,
  slideNumber,
  totalSlides = 6,
  currentSlug,
  prevSlug,
  nextSlug,
} = Astro.props;

const slides = [
  { name: 'Overview', slug: '/summary' },
  { name: 'Projects', slug: '/summary/projects' },
  { name: 'Tech Stack', slug: '/summary/skills' },
  { name: 'Experience', slug: '/summary/experience' },
  { name: 'Awards & Research', slug: '/summary/awards' },
  { name: 'Contact', slug: '/summary/contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Bayu Pratama 16:9 Portfolio Deck</title>
    <meta
      name="description"
      content="Interactive 16:9 Bento-Grid Presentation Portfolio for Bayu Rizky Kurnia Pratama"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-[#F4F0EA] dark:bg-[#121212] text-black dark:text-white font-body antialiased flex flex-col justify-between p-2 sm:p-4 lg:p-6 select-none print:p-0 print:bg-white"
  >
    <!-- Top Control Bar (Hidden in Print) -->
    <header class="w-full max-w-[1600px] mx-auto mb-3 flex items-center justify-between gap-4 print:hidden">
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="px-3 py-1.5 bg-white dark:bg-neutral-900 border-2 border-black dark:border-white shadow-neo-sm dark:shadow-neo-dark-sm font-heading font-bold text-xs sm:text-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-none transition-all flex items-center gap-1.5"
          title="Return to standard website"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="hidden sm:inline">Main Web</span>
        </a>
        <div class="h-5 w-[2px] bg-black/20 dark:bg-white/20 hidden sm:block"></div>
        <div class="flex items-center gap-1.5 overflow-x-auto py-1">
          {slides.map((s, idx) => {
            const isActive = currentSlug === s.slug;
            return (
              <a
                href={s.slug}
                class={`px-2.5 py-1 text-xs font-mono font-bold border-2 border-black dark:border-white transition-all whitespace-nowrap ${
                  isActive
                    ? 'bg-accent text-black shadow-neo-sm dark:shadow-neo-dark-sm'
                    : 'bg-white/80 dark:bg-neutral-900/80 text-black dark:text-white opacity-70 hover:opacity-100'
                }`}
              >
                0{idx + 1}. {s.name}
              </a>
            );
          })}
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="print-btn"
          class="px-2.5 py-1.5 bg-white dark:bg-neutral-900 border-2 border-black dark:border-white shadow-neo-sm dark:shadow-neo-dark-sm font-mono text-xs font-bold hover:bg-accent hover:text-black transition-all flex items-center gap-1.5"
          title="Print / Save as 16:9 PDF"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
          <span class="hidden md:inline">Export PDF</span>
        </button>

        <button
          id="theme-toggle"
          class="p-1.5 bg-white dark:bg-neutral-900 border-2 border-black dark:border-white shadow-neo-sm dark:shadow-neo-dark-sm hover:bg-accent hover:text-black transition-all"
          aria-label="Toggle theme"
        >
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Main 16:9 Presentation Viewport -->
    <main class="w-full max-w-[1600px] mx-auto flex-1 flex items-center justify-center">
      <div
        id="slide-container"
        class="w-full aspect-auto lg:aspect-[16/9] max-h-[86vh] bg-white dark:bg-[#1A1A1A] border-3 sm:border-4 border-black dark:border-white shadow-neo-lg dark:shadow-neo-dark-lg p-4 sm:p-6 lg:p-7 flex flex-col justify-between overflow-y-auto lg:overflow-hidden relative print:border-none print:shadow-none print:max-h-none print:aspect-[16/9]"
      >
        <slot />

        <!-- Slide Footer Status -->
        <footer class="mt-4 pt-3 border-t-2 border-black/15 dark:border-white/15 flex items-center justify-between text-xs font-mono opacity-80 print:mt-2">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 bg-black dark:bg-white text-white dark:text-black font-bold">
              BAYU RKP
            </span>
            <span class="hidden sm:inline">Backend & System Design</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="hidden md:inline">Use [←] / [→] keys to navigate</span>
            <span class="font-bold text-accent px-2 py-0.5 bg-black dark:bg-neutral-800 border border-black dark:border-white">
              SLIDE 0{slideNumber} / 0{totalSlides}
            </span>
          </div>
        </footer>
      </div>
    </main>

    <!-- Bottom Navigation Bar (Hidden in Print) -->
    <nav class="w-full max-w-[1600px] mx-auto mt-3 flex items-center justify-between print:hidden">
      <div>
        {prevSlug ? (
          <a
            href={prevSlug}
            class="px-4 py-2 bg-white dark:bg-neutral-900 border-2 border-black dark:border-white shadow-neo-sm dark:shadow-neo-dark-sm font-heading font-bold text-xs sm:text-sm hover:bg-accent hover:text-black transition-all flex items-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Previous Slide
          </a>
        ) : (
          <span class="px-4 py-2 border-2 border-black/20 dark:border-white/20 opacity-30 font-heading font-bold text-xs sm:text-sm cursor-not-allowed">
            Previous Slide
          </span>
        )}
      </div>

      <div class="text-xs font-mono font-bold">
        {currentSlug !== '/summary' && (
          <a
            href="/summary"
            class="px-3 py-1.5 bg-accent text-black border-2 border-black dark:border-white shadow-neo-sm hover:shadow-none hover:translate-x-[1px] hover:translate-y-[1px] transition-all"
          >
            ⊞ Bento Overview
          </a>
        )}
      </div>

      <div>
        {nextSlug ? (
          <a
            href={nextSlug}
            class="px-4 py-2 bg-white dark:bg-neutral-900 border-2 border-black dark:border-white shadow-neo-sm dark:shadow-neo-dark-sm font-heading font-bold text-xs sm:text-sm hover:bg-accent hover:text-black transition-all flex items-center gap-2"
          >
            Next Slide
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        ) : (
          <a
            href="/summary"
            class="px-4 py-2 bg-accent text-black border-2 border-black dark:border-white shadow-neo-sm font-heading font-bold text-xs sm:text-sm hover:translate-x-[1px] hover:translate-y-[1px] transition-all"
          >
            Back to Start ↺
          </a>
        )}
      </div>
    </nav>

    <!-- Client-Side Keyboard Navigation & Print Script -->
    <script is:inline define:vars={{ prevSlug, nextSlug }}>
      document.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        if (e.key === 'ArrowRight' && nextSlug) {
          window.location.href = nextSlug;
        } else if (e.key === 'ArrowLeft' && prevSlug) {
          window.location.href = prevSlug;
        } else if (e.key === 'Escape') {
          window.location.href = '/summary';
        }
      });

      document.getElementById('print-btn')?.addEventListener('click', () => {
        window.print();
      });

      // Theme toggle support
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    </script>

    <style is:global>
      @media print {
        @page {
          size: 16in 9in;
          margin: 0;
        }
        body {
          background: white !important;
          color: black !important;
          padding: 0 !important;
        }
      }
    </style>
  </body>
</html>
