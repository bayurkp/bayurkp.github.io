{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint src --ext .astro,.ts,.tsx,.js",
    "lint:fix": "eslint src --ext .astro,.ts,.tsx,.js --fix",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,js,md}\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "@lucide/astro": "^1.25.0",
    "astro": "^5.0.0",
    "mermaid": "^11.16.1",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.64.0"
  }
}
